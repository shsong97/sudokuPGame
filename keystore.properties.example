# 릴리스 서명 설정 예시. 이 파일을 keystore.properties 로 복사해 값을 채운다.
# keystore.properties 와 키 파일(*.jks)은 git에 올리지 않는다 (.gitignore).
#
# 키 만들기:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias sudokupgame
storeFile=release.jks
storePassword=
keyAlias=sudokupgame
keyPassword=
